{
  "name": "@punchline-hq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev --listen 3001",
    "dev:e2e": "tsx src/dev.ts",
    "build": "pnpm --filter @punchline-hq/contracts build && pnpm --filter @punchline-hq/auth build && pnpm --filter @punchline-hq/db build && pnpm --filter @punchline-hq/telemetry build && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "@punchline-hq/auth": "workspace:*",
    "@punchline-hq/contracts": "workspace:*",
    "@punchline-hq/db": "workspace:*",
    "@punchline-hq/telemetry": "workspace:*",
    "drizzle-orm": "latest",
    "hono": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vercel": "latest"
  }
}
