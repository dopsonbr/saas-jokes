OPENAI_API_KEY=
# AI_PROVIDER=vercel-gateway uses VERCEL_OIDC_TOKEN automatically on Vercel.
OTEL_SERVICE_NAME=saas-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
