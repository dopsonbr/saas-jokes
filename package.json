{
  "name": "punchline-hq",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "e2e": "pnpm --filter @punchline-hq/e2e test",
    "e2e:web": "pnpm --filter @punchline-hq/e2e test:web",
    "e2e:api": "pnpm --filter @punchline-hq/e2e test:api",
    "e2e:install": "pnpm --filter @punchline-hq/e2e install:browsers",
    "init:project": "node scripts/init-template.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@biomejs/biome": "2.5.11"
  }
}
