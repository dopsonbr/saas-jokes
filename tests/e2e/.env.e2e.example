# Use a dedicated Clerk development instance and a dedicated Neon test database.
# Never point local E2E at production credentials or production customer data.

# Clerk values used by both the web app and Playwright Clerk helpers
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
EXPECTED_CLERK_ORG_ID=org_xxx
E2E_WRONG_CLERK_ORG_ID=org_other
E2E_CLERK_USER_EMAIL=e2e+clerk_test@example.com

# Dedicated E2E Neon database
DATABASE_URL=postgresql://...

# Local paired-cell configuration
FRONTEND_URL=http://localhost:5177
VITE_API_URL=http://localhost:3101
CUSTOMER_SLUG=e2e-customer
PORT=3101
AI_PROVIDER=mock
# Set to live only when targeting a deployed live provider.
E2E_AI_PROVIDER=mock
